# Database
DATABASE_URL=postgresql+asyncpg://poc_user:poc_password@localhost:5432/assessments_db
POSTGRES_DB=assessments_db
POSTGRES_USER=poc_user
POSTGRES_PASSWORD=poc_password

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# AI Providers (configure the ones you want to use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=openai

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
